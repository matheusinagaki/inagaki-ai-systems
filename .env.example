OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
# Use a random value with at least 32 bytes in production. If omitted, the
# OpenRouter key is used only as a local compatibility fallback.
CHAT_SIGNING_SECRET=replace_with_a_random_32_byte_secret
# Optional but strongly recommended in production for a distributed rate limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Only enable outside Vercel when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false
